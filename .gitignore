# Entorno virtual
.venv/
venv/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Cachés de Python
__pycache__/
*.py[cod]
*$py.class

# Herramientas de testing y lint
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build y empaquetado
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Archivos temporales y logs
*.log
*.tmp
*.bak

# IDE / sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db

# Salidas pesadas del proyecto
recordings/**
videos/**

# Mantener estructura de carpetas en git (opcional con .gitkeep)
!recordings/.gitkeep
!videos/.gitkeep
